    "authors": [
        "Froz3nKill3r69"
    ],
    "contact": {
        "homepage": "https://github.com/justinscott12",
        "sources": "https://github.com/justinscott12/no-anvil-limit"
    },
    "license": "MIT",
    "icon": "assets/no-anvil-limit/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "com.noanvillimit.NoAnvilLimitMod"
        ]
    },
    "mixins": [
        "no-anvil-limit.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}"
    }
